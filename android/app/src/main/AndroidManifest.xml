<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau : tout le trafic passe par le Tor EMBARQUÉ de l'app (ADR-007). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Tor embarqué : service au premier plan (démon tor + notification persistante).
         v0.2.7 : type specialUse — le type dataSync est PLAFONNÉ à 6 h/24 h par
         Android 14+ (crash ForegroundServiceDidNotStopInTimeException, puis
         ForegroundServiceStartNotAllowedException en boucle au redémarrage —
         logs device v0.2.6 Blackview 12:51/13:24/14:28). Aucun type prédéfini
         ne correspond à un proxy Tor local ; specialUse est le type plateforme
         prévu pour ce cas (pas de plafond de durée). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- v0.2.60 — capture d'écran pour le PARTAGE D'ÉCRAN VALIDÉ des appels
         visio (le PC doit l'avoir autorisé par F_SCREEN_ACCEPT AVANT que le
         dialogue système Android ne propose la capture — double consentement). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v0.2.56 — décrocher verrouillé (session 78) : l'intent plein écran de la
         notification d'appel lance CallLockActivity SUR le keyguard (mécanisme
         officiel des apps téléphoniques ; Android 14+ : rétrogradable par
         réglage utilisateur — les boutons d'action restent le repli). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- v0.2.17 : notes vocales (MediaRecorder → pièce jointe audio). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v0.2.20 : visio — capture caméra pour l'encodeur H.264 du canal direct. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v0.2.20/v0.2.40 : mise à jour automatique (standard + canal test) —
         l'installateur système exige cette permission depuis Android 8
         (minSdk 26). ABSENTE en v0.2.20-v0.2.39 : l'installation était BLOQUÉE
         silencieusement par Android (l'intent ACTION_VIEW application/vnd.
         android.package-archive est rejeté) — correctif v0.2.40. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NyxApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nyx">

        <!-- allowBackup=false : les clés d'identité ne doivent JAMAIS être sauvegardées
             automatiquement (ADR-003). -->
        <!-- v0.2.35 : icône adaptative « Nyx, déesse de la nuit » (croissant +
             constellation sur ciel dégradé — cf. res/mipmap-anydpi-v26/). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lien d'invitation : nyx://add?o=<onion> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nyx" android:host="add" />
            </intent-filter>
        </activity>

        <!-- Démon Tor embarqué (ADR-007) : exécute le binaire tor embarqué (libTor.so)
             avec le torrc de l'app, héberge le service onion de l'utilisateur,
             tout le trafic client en sort. -->
        <service
            android:name=".tor.NyxTorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Démon Tor embarqué : proxy SOCKS 127.0.0.1 local utilisé par TOUTE la messagerie et hébergeant le service onion personnel (ADR-007) ; fonctionnement continu requis, aucun transfert média." />
        </service>

        <!-- v0.2.60 — PARTAGE D'ÉCRAN d'appel (MediaProjection) : ne tourne QUE
             pendant un appel visio dont le pair a VALIDÉ le partage
             (F_SCREEN_ACCEPT — protocole sc). Exigence Android 14+ : service au
             premier plan de type mediaProjection AVANT createVirtualDisplay. -->
        <service
            android:name=".p2p.screenshare.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- v0.2.14 : actions Accepter/Refuser des notifications d'invitation.
             exported=false : déclenchable UNIQUEMENT par nos propres
             PendingIntents (aucune app externe ne peut forger le choix). -->
        <receiver
            android:name=".notify.ContactActionReceiver"
            android:exported="false" />
        <!-- v0.2.56 — actions Décrocher/Refuser de la notification d'APPEL
             (fonctionnent écran verrouillé — session 78). -->
        <receiver
            android:name=".notify.CallActionReceiver"
            android:exported="false" />
        <!-- v0.2.56 — activité d'appel AU-DESSUS DU VERROUILLAGE SYSTÈME : lancée
             par l'intent plein écran de la notification (écran allumé). Ne montre
             JAMAIS de contenu de message (alias + durée seulement) ; se ferme seule
             à la fin de l'appel ; le verrou biométrique de l'app reste armé dessous. -->
        <activity
            android:name=".ui.call.CallLockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Nyx"
            tools:targetApi="27" />
            <!-- v0.2.20 — mise à jour automatique : l'APK téléchargé (cache) est
             remis à l'installateur système via ce FileProvider (read-only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
