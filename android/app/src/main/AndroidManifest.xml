<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau : tout le trafic passe par le Tor EMBARQUÉ de l'app (ADR-007). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Tor embarqué : service au premier plan (démon tor + notification persistante). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NyxApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nyx">

        <!-- allowBackup=false : les clés d'identité ne doivent JAMAIS être sauvegardées
             automatiquement (ADR-003). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lien d'invitation : nyx://add?o=<onion> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nyx" android:host="add" />
            </intent-filter>
        </activity>

        <!-- Démon Tor embarqué (ADR-007) : exécute le binaire tor embarqué (libTor.so)
             avec le torrc de l'app, héberge le service onion de l'utilisateur,
             tout le trafic client en sort. -->
        <service
            android:name=".tor.NyxTorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
