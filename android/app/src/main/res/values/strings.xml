    <string name="app_name">Nyx</string>
    <string name="onboarding_title">Bienvenue sur Nyx</string>
    <string name="onboarding_intro">Messagerie anonyme et chiffrée, entièrement passant par le réseau Tor. Votre identité est une adresse onion générée sur cet appareil : aucune inscription, aucune donnée personnelle.</string>
    <string name="onboarding_warning">Important : votre identité vit dans une clé secrète stockée sur cet appareil. Si vous perdez l\'appareil sans sauvegarde, votre compte est perdu définitivement.</string>
