    <!-- Verrou biométrique local opt-in (v0.1.2, ADR-010 §3) -->
    <string name="biometric_enable">Protéger l\'accès par biométrie</string>
    <string name="biometric_enable_desc">Empreinte ou code de l\'appareil demandés à chaque retour sur l\'application. La vérification est effectuée par l\'appareil : aucune donnée biométrique n\'est lue, stockée ni transmise.</string>
    <string name="biometric_unavailable">Indisponible : enregistrez d\'abord une empreinte ou un code sur cet appareil.</string>
    <string name="biometric_confirm_title">Confirmer pour activer le verrou</string>
    <string name="biometric_confirm_subtitle">Vérifiez votre empreinte ou votre code de l\'appareil</string>
    <string name="lock_title">Nyx est verrouillé</string>
    <string name="lock_subtitle">Vérifiez votre empreinte ou votre code de l\'appareil pour continuer</string>
    <string name="lock_unlock">Déverrouiller</string>
    <string name="lock_unavailable_desc">Aucun moyen de vérification disponible sur cet appareil (biométrie ou code supprimé). Vous pouvez désactiver le verrou pour accéder à l\'application.</string>
    <string name="lock_disable">Désactiver le verrou</string>

