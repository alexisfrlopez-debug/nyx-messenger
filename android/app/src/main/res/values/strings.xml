    <!-- Alias — pseudonyme unique optionnel (v0.1.2, wire-format.md §6) -->
    <string name="alias_title">Votre alias</string>
    <string name="alias_optional">Optionnel — un pseudonyme public unique pour vos invitations. N\'y mettez JAMAIS de nom réel : il est visible sur le réseau.</string>
